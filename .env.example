# SQLite file used by Prisma.
# Local: path is relative to the prisma/ directory.
# Render: use an absolute path on the persistent disk, e.g. file:/var/data/inkdesk.db
DATABASE_URL="file:./dev.db"

# Used to sign session cookies and to encrypt parlor Stripe secrets at rest.
# Generate a new value for production (do not reuse this example string):
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin (no trailing slash). Required on Render so Stripe redirects and
# server actions know the HTTPS host. Local default is inferred from the request.
# NEXT_PUBLIC_APP_URL="http://127.0.0.1:43147"
# APP_URL is a server-only alias if you prefer not to use the NEXT_PUBLIC_ prefix.
# APP_URL="http://127.0.0.1:43147"

# Parlor image uploads. Local default: ./storage
# Render Blueprint sets this to /var/data/storage (persistent disk).
# STORAGE_ROOT="/var/data/storage"

# Optional local-dev fallback for the demo shop only. The primary path is
# Admin → Parlor settings (each parlor’s own Stripe account). Do not rely on a
# shared platform Stripe account.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
