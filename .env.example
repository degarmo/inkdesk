# SQLite file used by Prisma (path is relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Used to sign session cookies and to encrypt parlor Stripe secrets at rest.
# Generate a new value for production:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional public origin for Stripe redirect URLs if the request host is unavailable.
# APP_URL="http://127.0.0.1:43147"

# Optional local-dev fallback for the demo shop only. The primary path is
# Admin → Parlor settings (each parlor’s own Stripe account). Do not rely on a
# shared platform Stripe account.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
