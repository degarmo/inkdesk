# PostgreSQL connection string (Prisma and the Django API). SQLite file: URLs are not supported.
#
# Local Docker (see docker-compose.yml). Django reads this same value from the repo-root .env.
DATABASE_URL="postgresql://inkdesk:inkdesk@localhost:5432/inkdesk?schema=public"
#
# Render Internal URL is injected by the Blueprint (fromDatabase → DATABASE_URL).
# For laptop access via Render's External Database URL, copy it from the
# Postgres dashboard and append sslmode=require, for example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/inkdesk?sslmode=require"

# Used to sign session cookies and to encrypt parlor Stripe secrets at rest.
# Generate a new value for production (do not reuse this example string):
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin (no trailing slash). Required on Render so Stripe redirects and
# server actions know the HTTPS host. Local default is inferred from the request.
# NEXT_PUBLIC_APP_URL="http://127.0.0.1:43147"
# APP_URL is a server-only alias if you prefer not to use the NEXT_PUBLIC_ prefix.
# APP_URL="http://127.0.0.1:43147"

# Parlor image uploads. Local default: ./storage
# Render Blueprint sets this to /var/data/storage (persistent disk; not the database).
# STORAGE_ROOT="/var/data/storage"

# Optional local-dev fallback for the demo shop only. The primary path is
# Admin → Parlor settings (each parlor’s own Stripe account). Do not rely on a
# shared platform Stripe account.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Django API (Phase 1). Next.js does not call this yet. See backend/.env.example
# for DJANGO_SECRET_KEY and DJANGO_DEBUG. Local default: http://127.0.0.1:8000
# DJANGO_API_URL="http://127.0.0.1:8000"
# NEXT_PUBLIC_DJANGO_API_URL is not wired in the UI. Phase 2 will add it when
# server actions / route handlers start fetching the Django API.
