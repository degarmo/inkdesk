# Django API — copy to backend/.env or export in the shell.
# DATABASE_URL can also come from the repo-root .env (same Postgres as Prisma).

# Required. Local placeholder only — generate a new value for Render:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY="dev-only-change-me"

# true on a laptop. false (or unset) on Render.
DJANGO_DEBUG=true

# Same PostgreSQL instance Prisma uses. SQLite file: URLs are rejected.
DATABASE_URL="postgresql://inkdesk:inkdesk@localhost:5432/inkdesk"

ALLOWED_HOSTS="localhost,127.0.0.1"

# Origins allowed to call this API from a browser. Next.js local default:
CORS_ALLOWED_ORIGINS="http://localhost:43147,http://127.0.0.1:43147"

# Gunicorn / runserver bind is PORT (Render sets this). Local default is 8000.
# PORT=8000
